{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json", ".oxlintrc.jsonc", ".oxfmtrc.jsonc"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "//#format:run": {},
    "//#format:check:run": {},
    "typecheck": {},
    "test": {}
  }
}
