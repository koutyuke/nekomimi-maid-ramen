{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "sortImports": {
    "internalPattern": ["@nekomimi/"],
    "newlinesBetween": false,
    "groups": [
      ["side_effect_style", "side_effect", "style"],
      { "newlinesBetween": true },
      "value-builtin",
      "type-builtin",
      { "newlinesBetween": true },
      "value-external",
      "type-external",
      { "newlinesBetween": true },
      ["value-internal", "value-parent", "value-sibling", "value-index"],
      ["type-internal", "type-parent", "type-sibling", "type-index"],
      "unknown",
    ],
  },
  "overrides": [
    {
      // Tailwind CSSを使うのは公開サイトだけである。独自の色やユーティリティも並び順を判定できるよう、サイトのスタイルシートを読む。
      "files": ["apps/site/**"],
      "options": {
        "sortTailwindcss": { "stylesheet": "./apps/site/src/layers/app/styles/global.css" },
      },
    },
  ],
  "ignorePatterns": [
    "apps/api/worker-configuration.d.ts",
    "apps/api/drizzle/**",
    "apps/staff/src/routeTree.gen.ts",
    "apps/site/src/routeTree.gen.ts",
  ],
}
