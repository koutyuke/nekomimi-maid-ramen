{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "sortImports": {
    "internalPattern": ["@nekomimi/"],
    "newlinesBetween": false,
    "groups": [
      ["side_effect_style", "side_effect", "style"],
      { "newlinesBetween": true },
      "value-builtin",
      "type-builtin",
      { "newlinesBetween": true },
      "value-external",
      "type-external",
      { "newlinesBetween": true },
      ["value-internal", "value-parent", "value-sibling", "value-index"],
      ["type-internal", "type-parent", "type-sibling", "type-index"],
      "unknown",
    ],
  },
  "ignorePatterns": ["apps/api/worker-configuration.d.ts", "apps/api/drizzle/**", "apps/web/src/routeTree.gen.ts"],
}
