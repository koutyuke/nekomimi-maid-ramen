{
  "name": "@nekomimi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/public.ts"
    }
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types --strict-vars false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply nekomimi-ramen --local",
    "db:migrate:remote": "wrangler d1 migrations apply nekomimi-ramen --remote",
    "db:seed:local": "wrangler d1 execute nekomimi-ramen --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute nekomimi-ramen --remote --file=./seed.sql",
    "db:studio": "drizzle-kit studio --config=drizzle.studio.config.ts",
    "db:studio:remote": "drizzle-kit studio --config=drizzle.studio.config.remote.ts",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --var ENVIRONMENT:development",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.16",
    "@elysiajs/cors": "^1.4.2",
    "@nekomimi/core": "workspace:*",
    "better-auth": "1.7.3",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "elysia": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "better-sqlite3": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
