{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nekomimi-ramen-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "api.nekomimi-ramen.com",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nekomimi-ramen",
      "database_id": "fd25a1b6-3b25-4c6c-abbc-754e74bbf07c",
      "migrations_dir": "drizzle",
    },
  ],
  "vars": {
    "ORIGIN": "https://nekomimi-ramen.com",
  },
}
