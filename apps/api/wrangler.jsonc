{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nekomimi-ramen-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "api.nekomimi-ramen.com",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nekomimi-ramen",
      "database_id": "fd25a1b6-3b25-4c6c-abbc-754e74bbf07c",
      "migrations_dir": "drizzle",
    },
  ],
  "secrets": {
    "required": ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "BETTER_AUTH_SECRET", "OWNER_EMAIL"],
  },
  "vars": {
    "ENVIRONMENT": "production",
    "SCHOOL_DOMAIN": "gm.ibaraki-ct.ac.jp",
  },
}
