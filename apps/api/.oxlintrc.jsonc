{
  "extends": ["../../.oxlintrc.jsonc"],
  "plugins": [],
  "rules": {
    // Effectのタグ付きエラーは`_tag`で種類を判別する。ライブラリが定める名前であり変更できない。
    "no-underscore-dangle": ["error", { "allow": ["_tag"] }],
    "oxc/no-map-spread": "off",
  },
  "ignorePatterns": ["dist/**", ".wrangler/**", "worker-configuration.d.ts", "drizzle/**"],
  "overrides": [
    {
      "files": ["src/routes/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/*.live", "**/infra/**"],
                "message": "実装ではなくポートを読む。実装の組み立ては`src/index.ts`が行う。",
              },
              {
                "group": [
                  "**/{inventory,visitor-information,sales,kitchen,handoff,operations}",
                  "**/{inventory,visitor-information,sales,kitchen,handoff,operations}/**",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/public",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/public.ts",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/testing",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/testing/index",
                ],
                "message": "業務領域は公開面(`features/{領域}/public`)から読む。",
              },
              {
                "group": ["**/features/*/layer", "**/layer"],
                "message": "`layer`を読むのは`src/index.ts`だけである。",
              },
            ],
          },
        ],
      },
    },
    {
      // 経路のテストだけは`features/{領域}/testing`を入口として使える。実装側では
      // `regex`でディレクトリ入口も禁止し、内部のmockを直接参照する抜け道を残さない。
      "files": ["src/routes/**"],
      "excludeFiles": [
        "src/routes/**/tests/**",
        "src/routes/**/testing/**",
        "src/routes/**/*.test.ts",
        "src/routes/**/*.spec.ts",
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/*.live", "**/infra/**"],
                "message": "実装ではなくポートを読む。実装の組み立ては`src/index.ts`が行う。",
              },
              {
                "group": [
                  "**/{inventory,visitor-information,sales,kitchen,handoff,operations}",
                  "**/{inventory,visitor-information,sales,kitchen,handoff,operations}/**",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/public",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/public.ts",
                ],
                "message": "業務領域は公開面(`features/{領域}/public`)から読む。",
              },
              {
                "group": ["**/features/*/layer", "**/layer"],
                "message": "`layer`を読むのは`src/index.ts`だけである。",
              },
              {
                "group": ["**/tests", "**/tests/**", "**/testing", "**/testing/**"],
                "message": "本番コードからテスト用のコードを読まない。",
              },
              {
                "regex": "(?:^|/)(?:tests|testing)(?:/|$)",
                "message": "本番コードからテスト用のコードを読まない。",
              },
            ],
          },
        ],
      },
    },
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/features/**"],
                "message": "`core`は業務領域を読まない。共有する定義は`core`側へ置く。",
              },
              {
                "group": ["**/tests", "**/tests/**", "**/testing", "**/testing/**"],
                "message": "本番コードからテスト用のコードを読まない。",
              },
              {
                "regex": "(?:^|/)(?:tests|testing)(?:/|$)",
                "message": "本番コードからテスト用のコードを読まない。",
              },
            ],
          },
        ],
      },
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/{inventory,visitor-information,sales,kitchen,handoff,operations}",
                  "**/{inventory,visitor-information,sales,kitchen,handoff,operations}/**",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/public",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/public.ts",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/testing",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/testing/index",
                ],
                "message": "他の業務領域は公開面(`features/{領域}/public`)または`features/{領域}/testing`から読む。",
              },
              {
                "group": ["**/core/adapters/**"],
                "message": "`core/adapters`はルートハンドラのための処理であり、業務領域から読まない。",
              },
              {
                "group": ["**/features/*/layer", "**/layer"],
                "message": "`layer`を読むのは`src/index.ts`だけである。",
              },
              {
                "group": ["**/tests", "**/tests/**", "**/testing", "**/testing/**"],
                "message": "本番コードからテスト用のコードを読まない。",
              },
              {
                "regex": "(?:^|/)(?:tests|testing)(?:/|$)",
                "message": "本番コードからテスト用のコードを読まない。",
              },
            ],
          },
        ],
      },
    },
    {
      "files": ["src/features/*/application/**", "src/features/*/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/{inventory,visitor-information,sales,kitchen,handoff,operations}",
                  "**/{inventory,visitor-information,sales,kitchen,handoff,operations}/**",
                ],
                "message": "アプリケーションとドメインは他の業務領域を読まない。領域間の接続はアダプターで行う。",
              },
              {
                "group": ["**/*.live", "**/infra/**"],
                "message": "実装ではなくポートを読む。実装の組み立ては`layer.ts`で行う。",
              },
              {
                "group": ["**/core/adapters/**"],
                "message": "`core/adapters`はルートハンドラのための処理であり、業務領域から読まない。",
              },
              {
                "group": ["**/features/*/layer", "**/layer"],
                "message": "`layer`を読むのは`src/index.ts`だけである。",
              },
              {
                "group": ["**/tests", "**/tests/**", "**/testing", "**/testing/**"],
                "message": "本番コードからテスト用のコードを読まない。",
              },
              {
                "regex": "(?:^|/)(?:tests|testing)(?:/|$)",
                "message": "本番コードからテスト用のコードを読まない。",
              },
            ],
          },
        ],
      },
    },
    {
      "files": ["src/features/**/adapters/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "../../inventory/testing", "message": "本番コードからテスト用の入口を読まない。" },
              { "name": "../../sales/testing", "message": "本番コードからテスト用の入口を読まない。" },
              { "name": "../../visitor-information/testing", "message": "本番コードからテスト用の入口を読まない。" },
              { "name": "../../../inventory/testing", "message": "本番コードからテスト用の入口を読まない。" },
              { "name": "../../../sales/testing", "message": "本番コードからテスト用の入口を読まない。" },
              { "name": "../../../visitor-information/testing", "message": "本番コードからテスト用の入口を読まない。" },
            ],
            "patterns": [
              {
                "group": [
                  "**/{inventory,visitor-information,sales,kitchen,handoff,operations}",
                  "**/{inventory,visitor-information,sales,kitchen,handoff,operations}/**",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/public",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/public.ts",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/testing",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/testing/index",
                ],
                "message": "他の業務領域は公開面(`features/{領域}/public`)または`features/{領域}/testing`から読む。",
              },
              {
                "group": ["**/core/adapters/**"],
                "message": "`core/adapters`はルートハンドラのための処理であり、業務領域から読まない。",
              },
              {
                "group": ["**/features/*/layer", "**/layer"],
                "message": "`layer`を読むのは`src/index.ts`だけである。",
              },
              {
                "group": ["**/tests", "**/tests/**", "**/testing", "**/testing/**"],
                "message": "本番コードからテスト用のコードを読まない。",
              },
              {
                "regex": "(?:^|/)(?:tests|testing)(?:/|$)",
                "message": "本番コードからテスト用のコードを読まない。",
              },
            ],
          },
        ],
      },
    },
    {
      "files": ["src/features/*/public.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/{inventory,visitor-information,sales,kitchen,handoff,operations}",
                  "**/{inventory,visitor-information,sales,kitchen,handoff,operations}/**",
                ],
                "message": "公開面は自領域の契約だけを公開し、他領域や内部実装を読まない。",
              },
              {
                "group": ["**/*.live", "**/infra/**", "**/layer"],
                "message": "公開面へ実装の組み立てを漏らさない。",
              },
              {
                "group": ["**/tests", "**/tests/**", "**/testing", "**/testing/**"],
                "message": "公開面からテスト用のコードを読まない。",
              },
              {
                "regex": "(?:^|/)(?:tests|testing)(?:/|$)",
                "message": "公開面からテスト用のコードを読まない。",
              },
            ],
          },
        ],
      },
    },
    {
      "files": ["src/features/*/layer.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/{inventory,visitor-information,sales,kitchen,handoff,operations}",
                  "**/{inventory,visitor-information,sales,kitchen,handoff,operations}/**",
                  "!./adapters/**",
                  "!./application/**",
                  "!./domain/**",
                  "!./public",
                  "!./public.ts",
                ],
                "message": "layerは自領域の実装を組み立て、他領域は公開面から読む。",
              },
              {
                "group": ["**/features/*/layer", "**/layer"],
                "message": "layerから他のlayerを読まない。",
              },
              {
                "group": ["**/tests", "**/tests/**", "**/testing", "**/testing/**"],
                "message": "layerからテスト用のコードを読まない。",
              },
              {
                "regex": "(?:^|/)(?:tests|testing)(?:/|$)",
                "message": "layerからテスト用のコードを読まない。",
              },
            ],
          },
        ],
      },
    },
    {
      "files": [
        "src/features/**/tests/**",
        "src/features/**/testing/**",
        "src/features/**/*.test.ts",
        "src/features/**/*.spec.ts",
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/{inventory,visitor-information,sales,kitchen,handoff,operations}",
                  "**/{inventory,visitor-information,sales,kitchen,handoff,operations}/**",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/public",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/public.ts",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/testing",
                  "!**/{inventory,visitor-information,sales,kitchen,handoff,operations}/testing/index",
                ],
                "message": "テスト用コードも他領域の公開面またはtesting入口だけを読む。",
              },
            ],
          },
        ],
      },
    },
  ],
}
